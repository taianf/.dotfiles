export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(
    git
    autojump
    brew
    copybuffer
    copyfile
    dirhistory
    dotenv
    fzf
    web-search
    zsh-autosuggestions
    zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# Load personal aliases.
[[ -f "$HOME/.zsh_aliases" ]] && source "$HOME/.zsh_aliases"

# Load and export personal environment variables.
_load_user_env() {
  setopt localoptions allexport
  source "$HOME/.env"
}
[[ -f "$HOME/.env" ]] && _load_user_env
unfunction _load_user_env

eval "$(rbenv init -)"
export PATH="$HOME/.rbenv/bin:$PATH"
